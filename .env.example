# ─────────────────────────────────────────────
#  HERMES NOTIFIER — Variables de entorno
#  Copia este archivo a ".env" y rellena los valores.
#  NUNCA subas el .env a git (ya está en .gitignore).
# ─────────────────────────────────────────────

# ── Gmail OAuth2 ──────────────────────────────
# Obtenidos de Google Cloud Console (OAuth Desktop App)
GMAIL_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=TU_CLIENT_SECRET

# Generado corriendo: python get_refresh_token.py
GMAIL_REFRESH_TOKEN=TU_REFRESH_TOKEN

# ── Telegram ──────────────────────────────────
# Token del bot (de @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tu chat ID personal (visita https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=123456789

# ── Keywords a monitorear ─────────────────────
# Lista de términos separados por coma.
# Soporta sintaxis de Gmail: subject:X, from:X, etc.
GMAIL_KEYWORDS=Quantathon,DojoChallenge,Hackathon 2026

# ── Opcionales ────────────────────────────────
# Cada cuántos segundos revisa el correo (default: 120)
POLL_INTERVAL_SECONDS=120
